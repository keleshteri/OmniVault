# Obsidian workspace state (local per-device, not shared)
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache

# Obsidian trash
.trash/

# Plugins that store credentials or local state
.obsidian/plugins/obsidian-git/data.json

# PageIndex RAG — runtime node_modules (large, auto-copied by deploy script)
.obsidian/plugins/pageindex-rag/node_modules/

# PageIndex RAG — generated index files (large, regeneratable from source docs)
.pageindex/

# macOS
.DS_Store

# Windows
Thumbs.db
desktop.ini
